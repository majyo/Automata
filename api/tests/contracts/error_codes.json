{
  "$comment": [
    "Canonical external error codes (M0 contract baseline).",
    "These are part of the published protocol: internal renames must not",
    "change them. Each entry states the surface that emits it and the",
    "envelope fields the client may rely on."
  ],
  "websocket_errors": [
    {
      "code": "unsupported_message_type",
      "envelope": { "type": "error", "message": "Unsupported message type" },
      "emitted_by": "services/connection.py"
    },
    {
      "code": "missing_session_id",
      "envelope": { "type": "error", "message": "Missing session_id" },
      "emitted_by": "services/connection.py"
    },
    {
      "code": "session_not_found",
      "envelope": { "type": "error", "message": "Session not found" },
      "emitted_by": "services/connection.py"
    },
    {
      "code": "missing_prompt",
      "envelope": { "type": "error", "message": "Missing prompt" },
      "emitted_by": "services/connection.py"
    },
    {
      "code": "session_busy",
      "envelope": {
        "type": "run_error",
        "code": "session_busy",
        "message": "This session already has an active run."
      },
      "emitted_by": "services/connection.py"
    },
    {
      "code": "run_not_found",
      "envelope": { "type": "run_error", "code": "run_not_found" },
