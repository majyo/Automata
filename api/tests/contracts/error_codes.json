    },
    {
      "code": "input_request_conflict",
      "envelope": { "type": "run_error", "code": "input_request_conflict" },
      "emitted_by": "services/connection.py"
    },
    {
      "code": "missing_input_id",
      "envelope": { "type": "error", "message": "Missing input_id" },
      "emitted_by": "services/connection.py"
    },
    {
      "code": "input_not_found",
      "envelope": {
        "type": "run_error",
        "code": "input_not_found",
        "input_id": "input-sample"
      },
      "emitted_by": "services/connection.py"
    },
    {
      "code": "input_not_cancellable",
      "envelope": {
        "type": "run_error",
        "code": "input_not_cancellable",
        "input_id": "input-sample"
      },
      "emitted_by": "services/connection.py"
    },
    {
      "code": "event_cursor_invalid",
      "envelope": {
        "type": "run_error",
        "code": "event_cursor_invalid",
        "message": "The requested run event cursor is invalid."
      },
      "emitted_by": "services/connection.py"
    },
    {
      "code": "approval_run_not_found",
      "envelope": { "type": "approval_error", "code": "run_not_found" },
      "emitted_by": "services/connection.py"
    },
    {
      "code": "plan_not_retryable",
      "envelope": { "type": "plan_error", "code": "plan_not_retryable" },
      "emitted_by": "services/connection.py"
    },
    {
      "code": "missing_plan_id",
      "envelope": { "type": "plan_error", "message": "Missing plan_id" },
      "emitted_by": "services/connection.py"
    },
    {
      "code": "duplicate_side_effect_confirmation_required",
      "envelope": {
