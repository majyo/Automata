AUTOMATA_LLM_API_KEY=
# Required for headless mode; desktop mode generates an ephemeral token.
AUTOMATA_API_TOKEN=replace-with-at-least-32-random-characters
AUTOMATA_LLM_BASE_URL=https://api.deepseek.com
AUTOMATA_LLM_MODEL=deepseek-v4-pro
AUTOMATA_LLM_TIMEOUT_SECONDS=120
AUTOMATA_LLM_TEMPERATURE=0.2
AUTOMATA_CONTEXT_COMPRESSION_ENABLED=true
AUTOMATA_CONTEXT_MAX_TOKENS=1000000
AUTOMATA_CONTEXT_COMPRESSION_TRIGGER_RATIO=0.8
# Optional exact override; defaults to max tokens * trigger ratio * 4 chars/token.
# AUTOMATA_CONTEXT_COMPRESSION_THRESHOLD_CHARS=3200000
AUTOMATA_CONTEXT_COMPRESSION_TARGET_CHARS=20000

# Observability is diagnostic by default. Profile mode must be enabled at startup.
AUTOMATA_OBSERVABILITY_MODE=diagnostic
AUTOMATA_PROFILE_CAPTURE_CONTENT=false
# AUTOMATA_OBSERVABILITY_DIR=
AUTOMATA_OBSERVABILITY_QUEUE_SIZE=8192
AUTOMATA_PROFILE_SAMPLE_INTERVAL_MS=200
AUTOMATA_LOG_RETENTION_DAYS=30
AUTOMATA_LOG_MAX_BYTES=536870912
AUTOMATA_PROFILE_RETENTION_DAYS=7
AUTOMATA_PROFILE_MAX_BYTES=2147483648
AUTOMATA_CONTENT_PROFILE_RETENTION_HOURS=24
AUTOMATA_CONTENT_PROFILE_MAX_BYTES=524288000
